# ============================================================
# .gitignore - 生鲜团购项目
# 按组长要求配置
# ============================================================

# 1. 编辑器本地配置
.vscode/
.idea/
*.swp
*.swo
*~

# 2. 编译产物、缓存、日志
node_modules/
dist/
build/
.cache/
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. 本地私有配置、密码密钥
.env
.env.local
.env.*.local
config.local.js
*.pem
*.key

# 4. 系统生成文件
Thumbs.db
.DS_Store
desktop.ini

# 5. 小程序个人本地配置
project.private.config.json

# 6. 上传的文件（运行时生成，不入库）
public/uploads/

# 7. 其他
*.zip
*.tar.gz
*.rar
