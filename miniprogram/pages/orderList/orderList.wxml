<view wx:if="{{orderList.length>0}}">
  <view wx:for="{{orderList}}" wx:key="orderId" class="order-item" bindtap="goDetail" data-id="{{item.orderId}}">
    <text>订单号：{{item.orderId}}</text>
    <text>时间：{{item.createTime}}</text>
    <text>金额：¥{{item.totalMoney}}</text>
    <text>状态：{{item.status===0?"待付款":"已完成"}}</text>
  </view>
</view>
<view wx:else class="empty">暂无订单</view>
