.container{padding:10rpx;}
.cart-item{display:flex;align-items:center;padding:20rpx;border-bottom:1rpx solid #eee;gap:15rpx;}
.info{flex:1;}
.price{color:#f44;}
.num-box{display:flex;align-items:center;gap:10rpx;}
.bottom-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx #eee solid;}
.total{color:red;font-weight:bold;}
.empty{text-align:center;margin-top:200rpx;color:#999;}
